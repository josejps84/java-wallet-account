<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 1. Carga los estilos y logs por defecto de Spring Boot -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- 2. Tu configuración personalizada solo se activará en producción -->
    <springProfile name="prod">
        <!-- Mueve AQUÍ adentro todo lo que tienes actualmente (tus appenders de archivo, etc.) -->
        <root level="INFO">
            <!-- Tus appenders personalizados -->
        </root>
    </springProfile>

    <!-- 3. Si NO es producción (por ejemplo, local/default), usa el comportamiento normal de consola -->
    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

</configuration>


