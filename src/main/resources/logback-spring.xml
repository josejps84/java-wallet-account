<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Configuración del formato de salida en Consola -->
    <appender name="CUSTOM_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>

        <!-- FILTRO 1: Aceptar explícitamente INFO -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>DEBUG</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>

        <!-- FILTRO 2: Aceptar explícitamente ERROR -->
        <!--
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch> 
        </filter>
        -->
    </appender>

    <!-- Aplicar la configuración al Logger Raíz -->
    <root level="TRACE">
        <appender-ref ref="CUSTOM_CONSOLE" />
    </root>

</configuration>
